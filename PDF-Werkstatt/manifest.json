{
  "id": "./?app=pdf-werkstatt",
  "name": "PDF-Werkstatt",
  "short_name": "PDF",
  "description": "Dokumente lesen, alles in PDF umwandeln, PDFs trennen und unterschreiben – alles auf dem Handy",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e0b07",
  "theme_color": "#0e0b07",
  "lang": "de",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "dateien",
          "accept": [
            "application/pdf",
            "image/*",
            "text/*",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.oasis.opendocument.text",
            "application/vnd.oasis.opendocument.spreadsheet",
            "application/vnd.oasis.opendocument.presentation",
            "application/epub+zip",
            "application/rtf",
            "application/msword",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".gif",
            ".docx",
            ".xlsx",
            ".pptx",
            ".odt",
            ".ods",
            ".odp",
            ".epub",
            ".txt",
            ".csv",
            ".rtf",
            ".doc"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}